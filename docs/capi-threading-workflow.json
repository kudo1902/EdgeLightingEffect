  "cards": [
    {
      "dot": "cyan",
      "title": "Single mode is the historical path",
      "items": [
        "No mutex taken, no queue allocated, el_effect_publish a no-op",
        "Callbacks fire inline, because gDispatchTarget is null off the render thread"
      ]
    },
    {
      "dot": "violet",
      "title": "What crosses the boundary in split mode",
      "items": [
        "Config is state, so the mailbox is newest-wins rather than a backlog",
        "Animation mutations are events, so they queue FIFO and drain before Update",
        "Callbacks defer, so a host callback may legally call el_effect_set_*"
      ]
    },
    {
      "dot": "amber",
      "title": "The seam is not update versus render",
      "items": [
        "el_effect_update uploads LUTs, VBOs and UBOs through OnConfigChanged",
        "That makes it a GL phase, so it stays on the render thread beside render",
        "Animations stay frame-locked there too, so timing matches single mode"
      ]
    }
  ]
