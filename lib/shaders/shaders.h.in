#ifndef _EDGE_LIGHTING_SHADERS_H_
#define _EDGE_LIGHTING_SHADERS_H_

// Auto-generated from lib/shaders/*.{vert,frag}.
// The GLSL version line is injected by CMake based on platform:
//   macOS  -> #version 330 core
//   Win/Linux -> #version 300 es
// The .frag/.vert files themselves contain no #version directive.
// neon-common.glsl is not a shader: it is the gather loop and its inputs,
// injected below into the two neon programs that run it. neon-pieces.glsl is
// not one either: the corner development and the glow coverage table's layout,
// injected into neon.frag and the bake that writes that table. neon-sdf.glsl
// (the rounded box's distance and the band's boundaries) goes into the three
// programs that draw that edge - neon.frag, the blit and the opaque fill - and
// neon-grade.glsl (the tone map) into neon.frag and the field's composite.
// neon-mask.glsl (the glow's one-sided cut and cutoffs, as coverage) goes into
// the three programs that apply it - neon.frag, the blit and the field's
// composite - after neon-sdf.glsl, whose distances it reads; into the field's
// composite under NEON_FIELD_RING only, the ring's variant that applies it, so
// the glow field's composite does not compile it for nothing.
// neon-ring.glsl (the ring atlas's strip lookup) goes into the two variants
// of the field's composite that read a packed ring - the ring's composite and
// the ring atlas's copy - and neon-light.glsl (the neon's light
// from its two shared parts) is exported, with the tuning header and the sdf,
// mask and ring chunks ahead of it, as NEON_LIGHT_GLSL for a host's shader.
// spotlight-dither.glsl (the spotlight's output noise) goes into the two
// programs that write that layer to the caller's framebuffer - spotlight.frag
// and the spotlight's blit.
// (No configure placeholder may appear in these comments - configure_file
// expands it here.)

namespace EdgeLighting
{
        namespace ShaderSource
        {
                static const char *const WIREFRAME_VERT_SRC = R"shadersrc(@GLSL_VERSION@
@WIREFRAME_VERT_CONTENT@
)shadersrc";

                static const char *const WIREFRAME_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@WIREFRAME_FRAG_CONTENT@
)shadersrc";

                static const char *const NEON_VERT_SRC = R"shadersrc(@GLSL_VERSION@
@NEON_VERT_CONTENT@
)shadersrc";

                static const char *const NEON_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@NEON_TUNING@
@NEON_COMMON@
@NEON_PIECES@
@NEON_SDF@
@NEON_MASK@
@NEON_GRADE@
@NEON_FRAG_CONTENT@
)shadersrc";

                static const char *const NEON_GATHER_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@NEON_TUNING@
@NEON_COMMON@
@NEON_GATHER_FRAG_CONTENT@
)shadersrc";

                static const char *const NEON_EMISSION_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@NEON_TUNING@
@NEON_EMISSION_FRAG_CONTENT@
)shadersrc";

                static const char *const NEON_GLOW_COVER_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@NEON_TUNING@
#define NEON_GLOW_COVER_BAKE
@NEON_PIECES@
@NEON_GLOW_COVER_FRAG_CONTENT@
)shadersrc";

                static const char *const NEON_GLOW_COVER_FILL_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@NEON_TUNING@
#define NEON_GLOW_COVER_FILL
@NEON_PIECES@
@NEON_GLOW_COVER_FILL_FRAG_CONTENT@
)shadersrc";

                static const char *const NEON_BLIT_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@NEON_TUNING@
@NEON_GRADE@
@NEON_SDF@
@NEON_MASK@
@NEON_BLIT_FRAG_CONTENT@
)shadersrc";

                static const char *const NEON_FIELD_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@NEON_TUNING@
@NEON_GRADE@
@NEON_SDF@
#ifdef NEON_FIELD_RING
@NEON_MASK@
#endif
#if defined(NEON_FIELD_RING) || defined(NEON_RING_COPY)
@NEON_RING@
#endif
@NEON_FIELD_FRAG_CONTENT@
)shadersrc";

                static const char *const NEON_ASSEMBLE_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@NEON_TUNING@
@NEON_SDF@
@NEON_MASK@
@NEON_RING@
@NEON_LIGHT@
@NEON_ASSEMBLE_FRAG_CONTENT@
)shadersrc";

                // The neon's light from its two shared parts, as one chunk for
                // a host's own fragment shader: put it after the version line
                // and call neonLight (see neon-light.glsl). Not a shader.
                static const char *const NEON_LIGHT_GLSL = R"shadersrc(
@NEON_TUNING@
@NEON_SDF@
@NEON_MASK@
@NEON_RING@
@NEON_LIGHT@
)shadersrc";

                static const char *const BLIT_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@BLIT_FRAG_CONTENT@
)shadersrc";

                static const char *const BLACK_RECT_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@NEON_SDF@
@BLACK_RECT_FRAG_CONTENT@
)shadersrc";

                static const char *const NEON_LUT_DEBUG_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@NEON_LUT_DEBUG_FRAG_CONTENT@
)shadersrc";

                static const char *const NEON_STOP_MARKER_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@NEON_STOP_MARKER_FRAG_CONTENT@
)shadersrc";

                static const char *const DEBUG_BUFFER_VIEW_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@DEBUG_BUFFER_VIEW_FRAG_CONTENT@
)shadersrc";

                static const char *const DROPLETS_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@DROPLETS_TUNING@
@DROPLETS_FRAG_CONTENT@
)shadersrc";

                static const char *const LENS_FLARE_VERT_SRC = R"shadersrc(@GLSL_VERSION@
@LENS_FLARE_VERT_CONTENT@
)shadersrc";

                static const char *const LENS_FLARE_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@LENS_FLARE_TUNING@
@LENS_FLARE_FRAG_CONTENT@
)shadersrc";

                static const char *const SPOTLIGHT_VERT_SRC = R"shadersrc(@GLSL_VERSION@
@SPOTLIGHT_VERT_CONTENT@
)shadersrc";

                static const char *const SPOTLIGHT_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@SPOTLIGHT_TUNING@
@SPOTLIGHT_DITHER@
@SPOTLIGHT_FRAG_CONTENT@
)shadersrc";

                static const char *const SPOTLIGHT_BLIT_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@SPOTLIGHT_TUNING@
@SPOTLIGHT_DITHER@
@SPOTLIGHT_BLIT_FRAG_CONTENT@
)shadersrc";

        }
}

#endif // _EDGE_LIGHTING_SHADERS_H_
