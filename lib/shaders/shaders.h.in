#ifndef _EDGE_LIGHTING_SHADERS_H_
#define _EDGE_LIGHTING_SHADERS_H_

// Auto-generated from lib/shaders/*.{vert,frag}.
// The GLSL version line is injected by CMake based on platform:
//   macOS  -> #version 330 core
//   Win/Linux -> #version 300 es
// The .frag/.vert files themselves contain no #version directive.

namespace EdgeLighting
{
        namespace ShaderSource
        {
                static const char *const WIREFRAME_VERT_SRC = R"shadersrc(@GLSL_VERSION@
@WIREFRAME_VERT_CONTENT@
)shadersrc";

                static const char *const WIREFRAME_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@WIREFRAME_FRAG_CONTENT@
)shadersrc";

                static const char *const NEON_VERT_SRC = R"shadersrc(@GLSL_VERSION@
@NEON_VERT_CONTENT@
)shadersrc";

                static const char *const NEON_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@NEON_TUNING@
@NEON_FRAG_CONTENT@
)shadersrc";

                static const char *const NEON_EMISSION_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@NEON_TUNING@
@NEON_EMISSION_FRAG_CONTENT@
)shadersrc";

                static const char *const NEON_BLIT_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@NEON_BLIT_FRAG_CONTENT@
)shadersrc";

                static const char *const BLACK_RECT_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@BLACK_RECT_FRAG_CONTENT@
)shadersrc";

                static const char *const NEON_LUT_DEBUG_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@NEON_LUT_DEBUG_FRAG_CONTENT@
)shadersrc";

                static const char *const NEON_STOP_MARKER_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@NEON_STOP_MARKER_FRAG_CONTENT@
)shadersrc";

                static const char *const DROPLETS_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@DROPLETS_TUNING@
@DROPLETS_FRAG_CONTENT@
)shadersrc";

                static const char *const LENS_FLARE_VERT_SRC = R"shadersrc(@GLSL_VERSION@
@LENS_FLARE_VERT_CONTENT@
)shadersrc";

                static const char *const LENS_FLARE_FRAG_SRC = R"shadersrc(@GLSL_VERSION@
@LENS_FLARE_FRAG_CONTENT@
)shadersrc";

        }
}

#endif // _EDGE_LIGHTING_SHADERS_H_
